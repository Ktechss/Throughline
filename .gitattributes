# Normalize line endings: store everything as LF in the repo and check out LF,
# regardless of the editor's OS. Ends the CRLF/LF churn where a file opened on
# Windows shows up as fully "modified" with no real change.
* text=auto eol=lf

# Scripts must stay LF (they run on the Linux/WSL deploy target).
*.sh   text eol=lf

# Binary assets — never touch their bytes.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.mp4  binary
*.mov  binary
*.npz  binary
*.onnx binary
*.zip  binary
*.ico  binary
